# AIMS WhatsApp POST bridge (post-only: delivery photos + signed DO into groups)
AIMS_API_BASE=https://aims-ahwy.onrender.com   # prod API
AIMS_POST_TOKEN=                                # a key of WA_POST_BRIDGES on the API (binds this worker to its org(s))
POST_ENABLED=false                              # kill switch: false = report groups + heartbeat, post nothing
POLL_MS=30000                                   # how often to look for posts
MEDIA_GAP_MS=2000                               # pause between the parts of a post
SESSION_DIR=/data/.wwebjs_auth                  # linked-device session on the persistent disk
# STATE_DIR=/data                               # post journal (default: next to SESSION_DIR)
# LIST_GROUPS=true                              # also log "GROUP:: <name> -> <id>" when reporting groups
# WA_WEB_VERSION=                               # pin the WhatsApp Web build if the live one breaks the library
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
