# Where the authenticated portal lives (Sign in button + legacy deep-link redirects)
NEXT_PUBLIC_APP_URL=https://app.ai-ms.io
# "Book a demo" target — a Calendly/Tally link or a mailto:. Falls back to a page anchor if unset.
NEXT_PUBLIC_DEMO_URL=
# Optional: where "Message the agent on WhatsApp" goes (e.g. https://wa.me/65XXXXXXXX). Hidden if unset.
NEXT_PUBLIC_WHATSAPP_URL=
# Set to 1 locally to render labelled placeholders for screenshots not captured yet
NEXT_PUBLIC_SHOW_PENDING=
