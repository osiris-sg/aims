// Global platform schema (TENANCY_MODE=per-org): identity + routing. Pushed by scripts/tenancy-push.ts.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters", "postgresqlExtensions"]
  output          = "../../node_modules/.prisma-tenancy/platform"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

model Organization {
  id                       String                     @id @default(uuid())
  name                     String                     @unique
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  address                  String?
  phoneNumber              String?
  registrationNumber       String?
  logo                     String?
  defaultStamp             String?
  customDocumentTypes      Json?
  taxRate                  Float?                     @default(9)
  // Org-wide defaults for the per-document tax toggles. The document editor
  // seeds new docs from these (documentInfo.taxApplicable / .absorbTax) so a
  // user who normally invoices with GST on top doesn't have to flip the
  // switch on every new draft. Per-doc overrides still win when set.
  taxApplicable            Boolean                    @default(true)
  absorbTax                Boolean                    @default(false)
  // ISO currency code (e.g. SGD, USD, MYR) used as the default for new
  // documents (documentInfo.currency). Per-doc overrides still win.
  defaultCurrency          String                     @default("SGD")
  // Round-down step for QF quote totals. Project quotes round the
  // Discounted Price (pre-GST) down to this step and roll the absorbed
  // amount into the Discount line. Route Order quotes round the Nett
  // Total (post-GST) down to this step and surface the crumb as a final
  // "Round-down" line. 0 = no rounding.
  quoteRoundingStep        Int                        @default(10)
  // Per-doc-type defaults for T&Cs / Notes / Footer message. Keyed by the
  // doc's `type` value (e.g. "QO1", "PO", "INVOICE"). Each entry is:
  // { tnc?: string, notes?: string, footerMessage?: string }. Seeded onto
  // documentInfo on new docs (per-doc overrides still win). Edited from
  // Company Profile → Doc Defaults tab.
  docTypeDefaults          Json?
  bankDetails              Json? // { accountName, accountNumber, bankName, swiftCode, branchCode, bankCode, currencyCode }
  stockDeductionTrigger    String?                    @default("DO") // Legacy field - no longer used. Stock deduction logic: DO always deducts, Invoice deducts only if not extracted from DO
  // Org-wide reward Points ledger. Float so partial-point adjustments stay
  // representable; decremented when a Route Order PO is confirmed by the
  // user's chosen "Less Points" amount on that PO. Inline-editable so the
  // user can seed it once Daikin tells them their starting balance.
  pointsBalance            Float?                     @default(0)
  documentTemplates        DocumentTemplate[]
  userOrganizations        UserOrganization[]
  modules                  OrganizationModule[]
  uiConfig                 OrganizationUIConfig?
  whatsAppConnection       WhatsAppConnection[]
  apiKeys                  ApiKey[]
}

model UserOrganization {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  salesmanCode   String? // Auto-generated code like S001, S002
  // The salesperson's own contact number, stamped onto documents they raise
  // (Biofuel quotations print it under the Salesman Code). Per-org because the
  // same Clerk user can sell for more than one organisation.
  salesmanMobile String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  joinedAt       DateTime     @default(now())
  lastActiveAt   DateTime?
  settings       Json?
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
  @@unique([salesmanCode, organizationId])
}

model OrganizationModule {
  id             String       @id @default(uuid())
  organizationId String
  moduleCode     String // 'ASSETS', 'INVENTORY', 'DOCUMENTS', 'PROJECTS', 'CUSTOMERS', 'INVOICES'
  enabled        Boolean      @default(true)
  displayName    String? // Custom label for this module
  icon           String? // Custom icon (Material UI icon name)
  sortOrder      Int? // Navigation order
  config         Json? // Module-specific configuration (routes, permissions, etc.)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, moduleCode])
  @@index([organizationId])
}

model OrganizationUIConfig {
  id               String       @id @default(uuid())
  organizationId   String       @unique
  theme            Json? // Colors, fonts, spacing: {primaryColor: '#..', secondaryColor: '#..'}
  navigationConfig Json? // Custom navigation structure
  dashboardLayout  Json? // Dashboard widget configuration
  terminology      Json? // Custom labels: {asset: 'Equipment', customer: 'Client'}
  dateFormat       String?      @default("MM/dd/yyyy")
  timeFormat       String?      @default("12h")
  currency         String?      @default("USD")
  language         String?      @default("en")
  features         Json? // Feature flags: {enableProjects: true, enableDocumentAI: false}
  branding         Json? // Additional branding config
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id])
}

model ApiKey {
  id             String    @id @default(uuid())
  organizationId String
  name           String // human label, e.g. "Weighbridge feed"
  prefix         String // first chars of the key (aims_xxxx…) for display
  keyHash        String    @unique // sha256(plaintext key)
  scopes         String[]  @default(["documents:create", "documents:read"])
  // When true, documents created by this key auto-post to the GL on create;
  // when false (default) they land as glPosting=pending in the Posting Queue.
  autoPost       Boolean   @default(false)
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdBy      String? // Clerk userId of the admin who minted it
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model DocumentTemplate {
  id               String                       @id @default(uuid()) @db.Uuid
  name             String?
  type             String // Document category: "INVOICE", "QUOTATION", "DELIVERY_ORDER", etc.
  templateVariant  String                       @default("Default") // Template design variant: "TI", "TI2", "QO1", "Default", etc.
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  config           Json?
  organizationId   String?
  // Template variant fields
  designName       String?                      @default("Default")
  description      String?
  thumbnail        String? // URL to preview thumbnail
  isActive         Boolean                      @default(false)
  isDefault        Boolean                      @default(false) // System default template
  mockData         Json? // Mock data for preview
  layoutConfig     Json? // Layout-specific configuration
  styleConfig      Json? // Styling configuration
  organization     Organization?                @relation(fields: [organizationId], references: [id])
  // Per-org activation selections (cascade-cleaned on template delete).
  activeSelections OrganizationActiveTemplate[]

  @@index([organizationId, type, isActive])
  @@index([organizationId, type])
  @@index([organizationId, type, templateVariant])
}

model OrganizationActiveTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String
  type           String // Document type, e.g. "QUOTATION"
  templateId     String   @db.Uuid
  // Multiple templates can be active per org+type. isPrimary marks the ONE used
  // as the default for headless creation (AI upload / quick-create) and the
  // pre-selected option in the creation picker. At most one primary per org+type
  // (enforced in the service, not the DB).
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // FK to the activated template so deleting a template cascades its selection
  // rows (fixes dangling OAT rows on template delete).
  template DocumentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([organizationId, type, templateId])
  @@index([templateId])
}

model OrganizationMemberProfile {
  id             String   @id @default(uuid())
  organizationId String
  userId         String // Clerk user id
  whatsappNumber String? // digits only, e.g. 6591234567
  commissionPct  Float? // default share of project profit for this designer
  yearlySalesTarget Float? // manager-set sales target (contract value signed per year)
  signatureImage String? // saved signature (PNG data URL) for one-tap counter-signing
  teamId         String? // hierarchy (CIEL 09-19): the Team this member belongs to
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([whatsappNumber])
  @@index([organizationId, teamId])
}

model DeviceToken {
  id             String   @id @default(uuid())
  userId         String // Clerk user id
  organizationId String
  token          String // FCM registration token
  platform       String   @default("android") // android | ios | web
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, token])
  @@index([organizationId])
}

model WhatsAppConnection {
  id                 String   @id @default(uuid())
  // Multiple numbers per org (guru 2026-09-13): each designer/line is its own
  // row; exactly one CONNECTED line per org is primary (default for outbound).
  organizationId     String
  // IDs handed back by Embedded Signup's postMessage session-info payload.
  wabaId             String
  phoneNumberId      String   @unique
  displayPhoneNumber String?
  verifiedName       String?
  // Business token from exchanging the Embedded Signup auth code. Scoped to
  // the client's shared WABA only — not our whole app.
  accessToken        String
  // 6-digit two-step-verification PIN set when we registered the number on
  // Cloud API; needed again for any future re-registration.
  pin                String?
  status             String   @default("CONNECTED") // CONNECTED | DISCONNECTED | ERROR
  lastError          String?
  connectedAt        DateTime @default(now())
  // Operator kill-switch for this line (guru 2026-09-13, CIEL: "read first,
  // actions later"): false = inbound messages are stored/readable in the CRM
  // but NEVER routed to the Operator agent, even for linked staff numbers.
  operatorEnabled    Boolean  @default(true)
  // Default line for outbound sends when the caller names no number.
  isPrimary          Boolean  @default(false)
  // Per-line inbound logic (guru 2026-09-13): 'standard' = store + operator
  // for linked staff; 'leads' = every customer message auto-creates/updates a
  // Lead (the ads-funnel number). More modes can join later.
  mode               String   @default("standard")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model WhatsAppWebhookEvent {
  id          String    @id @default(uuid())
  payload     Json
  status      String    @default("PENDING") // PENDING | DONE | ERROR
  error       String?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status, createdAt])
}

model OperatorIdentity {
  id             String    @id @default(uuid())
  channel        String // 'telegram' | 'whatsapp'
  channelUserId  String // Telegram numeric id (as string) | WhatsApp phone digits
  clerkUserId    String // the AIMS/Clerk user id this sender acts as
  organizationId String? // chosen active org (required once a user is in >1 org)
  displayName    String?
  verified       Boolean   @default(false)
  lastSeenAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([channel, channelUserId])
  @@index([clerkUserId])
}

model OperatorLinkCode {
  id          String    @id @default(uuid())
  code        String    @unique
  clerkUserId String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([clerkUserId])
}

model OperatorSession {
  id            String   @id @default(uuid())
  channel       String
  channelUserId String
  state         Json // { history: [...], pendingAction?: {...} }
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([channel, channelUserId])
}

model ActionLog {
  id             String   @id @default(uuid())
  actorType      String // USER | API_KEY | GUEST | SYSTEM
  actorId        String // Clerk userId | ApiKey id | token hint | system:<job>
  actorName      String? // "First Last" | key name | "System creation"
  actorEmail     String?
  organizationId String? // effective org (after X-Active-Org-Id override)
  homeOrgId      String? // admin's membership org when viewing-as another org
  channel        String? // portal | v1 | public | webhook | cron | operator
  method         String? // HTTP verb (null for non-HTTP system events)
  path           String? // URL path without query string
  action         String // VIEW | CREATE | UPDATE | DELETE | domain verb
  resource       String
  resourceId     String?
  statusCode     Int?
  durationMs     Int?
  ipAddress      String?
  userAgent      String?
  details        Json? // { query?, body? (summarised), error?, note? }
  status         String   @default("SUCCESS") // SUCCESS | FAILURE
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
  @@index([actorType, createdAt])
  @@index([resource, resourceId])
  @@index([organizationId, action, createdAt])
  @@index([createdAt])
}

/// NEW: local mirror of Clerk users (id = Clerk user id).
model User {
  id         String    @id
  email      String?
  name       String?
  imageUrl   String?
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

/// NEW: which Postgres schema holds each org's data, and which Prisma client (org file) reads it.
model OrgTenant {
  organizationId String   @id
  schemaName     String   @unique // org_biofuel, org_ciel, …
  prismaFile     String // orgs/biofuel.prisma, …
  status         String   @default("ACTIVE") // PROVISIONING | ACTIVE | MIGRATING | ARCHIVED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// NEW: routes a public token (pay / sign / delivery / share / customer-info link) to its org
/// before any org schema is known. Written alongside the token row in the org schema.
model PublicToken {
  token          String   @id
  kind           String // DELIVERY | DOCUMENT | SIGN | PROJECT | CUSTOMER_INFO | PAY
  organizationId String
  createdAt      DateTime @default(now())
  @@index([organizationId])
}

// ── Airwallex payment sync (YOURWORLD ticket sales, 2026-09-28) ─────────────
// Polls Airwallex payment_intents and books each succeeded order as a journal
// (Dr clearing / Cr revenue, reference = the STAR_ order id) so the ticket
// service's accounting always tallies. One connection per org.
model AirwallexConnection {
  id             String  @id @default(uuid())
  organizationId String  @unique
  // Airwallex API credentials (x-client-id + x-api-key → bearer token).
  // clientId nullable: key can be seeded first, sync stays off until both set.
  clientId       String?
  apiKey         String
  apiBase        String  @default("https://api.airwallex.com")
  // Only intents whose merchant_order_id / metadata.order_id starts with this
  // prefix belong to this org's ticket service.
  orderPrefix    String  @default("STAR-")
  // Posting map (codes resolved in the org's chart of accounts).
  clearingAccountCode String @default("CA103")
  revenueAccountCode  String @default("SS002")
  feeAccountCode      String @default("EX041")
  refundAccountCode   String @default("CS003")
  enabled        Boolean   @default(false)
  // Poll cursors per stream: only records created at/after these are fetched.
  syncFrom       DateTime?
  refundsFrom    DateTime?
  feesFrom       DateTime?
  lastSyncAt     DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
