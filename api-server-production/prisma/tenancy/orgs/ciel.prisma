  @@index([projectId, status])
}

model ProjectMilestone {
  id             String    @id @default(uuid())
  organizationId String
  projectId      String    @db.Uuid
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind           String    @default("milestone") // milestone | vo | refund
  label          String
  pct            Float?
  amount         Float     @default(0)
  sortOrder      Int       @default(0)
  dueTrigger     String? // confirmation | rendering | commencement | carpentry | handover
  invoiceId      String?   @db.Uuid
  paidAmount     Float     @default(0)
  paidAt         DateTime?
  paymentMethod  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, projectId])
}

// Designer advance request (guru 2026-10-06): a designer asks for money ahead
// of commission; Senior Manager/Master approve or decline. Approved advances
// show on the project's Contract & P&L "Advanced to designer" line and net
// off against commission at handover. paidAt is stamped when finance actually
// pays it out (bi-weekly run).
model DesignerAdvance {
  id              String    @id @default(uuid())
  organizationId  String
  projectId       String?   @db.Uuid
  projectName     String?
  requestedById   String
  requestedByName String?
  amount          Float
  reason          String?
  status          String    @default("pending") // pending | approved | declined | paid
  decidedById     String?
  decidedByName   String?
  decidedAt       DateTime?
  decisionNote    String?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, requestedById])
}

model ProjectQuestStep {
  id              String    @id @default(uuid())
  organizationId  String
  projectId       String    @db.Uuid
  stepNo          Int // 1..10, completion enforced in sequence
  title           String
  description     String?
  paymentTag      String? // "10%" | "40%" | "45%" | "5%" — collection milestone tied to the step
  requiresProof   Boolean   @default(false)
  status          String    @default("pending") // pending | done | skipped
  completedAt     DateTime?
  completedBy     String? // Clerk user id
  completedByName String?
  notes           String?
  proofUrl        String?
  proofKey        String?
  skipReason      String?
  points          Int       @default(0) // awarded points (structure TBD)
  // Media collected for this step outside the portal (e.g. the designer
  // replying to the 9am schedule WhatsApp with before photos/videos):
  // [{ url, key, type, caption, at, via }]
  attachments     Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([projectId, stepNo])
  @@index([organizationId, projectId])
}

model ProjectScheduleItem {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String   @db.Uuid
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label          String
  kind           String   @default("work") // work | note | holiday
  startDate      DateTime
  endDate        DateTime
  sortOrder      Int      @default(0)
  notes          String?
  reminderSentAt DateTime? // 9am designer WhatsApp ("send before video+photo") sent
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, projectId])
  @@index([projectId, startDate])
}

model ProjectShareLink {
  id         String    @id @default(uuid())
  token      String    @unique
  projectId  String    @db.Uuid
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind       String    @default("schedule")
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@index([projectId])
}

model QuestMediaRequest {
  id             String    @id @default(uuid())
  organizationId String
  projectId      String    @db.Uuid
  stepId         String? // ProjectQuestStep to attach media to (null → first pending proof step at capture time)
  scheduleItemId String?
  waNumber       String // designer's WhatsApp number, digits only
  label          String // schedule activity label, used in the message
  status         String    @default("open") // open | closed
  mediaCount     Int       @default(0)
  createdAt      DateTime  @default(now())
  lastMediaAt    DateTime?

  @@index([organizationId, waNumber, status])
  @@index([projectId])
}

model SupplierRebate {
  id             String   @id @default(uuid())
  organizationId String
  supplierName   String // normalized (lowercased, collapsed spaces)
  pct            Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, supplierName])
}

model Team {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  leaderUserId   String? // Clerk user id of the Junior Manager leading it
  yearlyTarget   Float? // team sales target (contract value signed per year)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
}

model WorkSection {
  id             String   @id @default(uuid())
  organizationId String
  letter         String? // display prefix: "A", "B", …
  title          String
  defaultNotes   String[] @default([])
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, title])
  @@index([organizationId, sortOrder])
}

model WhatsAppMessage {
  id             String  @id @default(uuid())
  organizationId String
  direction      String // OUTBOUND | INBOUND
  // E.164 counterparty number (recipient for outbound, sender for inbound).
  counterparty   String
  // Which line (WhatsAppConnection.phoneNumberId) carried this message —
  // null on rows from the single-number era.
  phoneNumberId  String?
  // Meta's message id (wamid...) — idempotency anchor for webhook redeliveries.
  waMessageId    String? @unique
  templateName   String?
  body           String?
  // queued → sent → delivered → read, or failed (statuses arrive via webhook).
  status         String  @default("queued")
  error          String?
  payload        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  @@index([organizationId, createdAt])
}

model WhatsAppQnA {
  id             String @id @default(uuid())
  organizationId String
  question       String
  answer         String
  // 1536-dim embedding of `question` (text-embedding-3-small), stored as a
  // JSON number array — same no-pgvector approach as DocumentEmbedding.
  embedding      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  @@index([organizationId])
}

model WhatsAppAgentConfig {
  id                String  @id @default(uuid())
  organizationId    String  @unique
  // Master switch: run the agent on inbound messages at all.
  enabled           Boolean @default(false)
  // Whether the AI may send replies without human review (only when it also
  // judges the message to be inside autoSendGuidance and is confident).
  autoSendEnabled   Boolean @default(false)
  // Management number (digits, country code) that receives internal prompts —
  // e.g. the new-lead assignment list (guru 2026-09-13).
  notifyNumber      String?
  // Plain-text description of the KINDS of messages the AI may answer on its
  // own, e.g. "opening hours, price list questions, delivery status".
  autoSendGuidance  String?
  // General tone/behaviour instructions appended to the system prompt.
  aiGuidance        String?
  // Owner/advisor number (digits incl. country code) that receives internal
  // notifications — e.g. a confirmation whenever a scheduled message goes out.
  ownerNotifyNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

}

model WhatsAppSuggestion {
  id               String  @id @default(uuid())
  organizationId   String
  // The inbound WhatsAppMessage this suggestion answers.
  inboundMessageId String  @unique
  counterparty     String
  inboundBody      String
  suggestedReply   String
  // AI's self-assessment: could this have been auto-sent under the org rules?
  canAutoSend      Boolean @default(false)
  confidence       Float?
  reason           String?
  // PENDING (awaiting review) | AUTO_SENT | APPROVED (group draft OK'd by button, bridge yet to post)
  // | SENT (approved, possibly edited) | DISMISSED | FAILED
  status           String  @default("PENDING")
  // The outbound WhatsAppMessage id once sent (auto or approved).
  sentMessageId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  @@index([organizationId, status, createdAt])
}

model WhatsAppScheduledMessage {
  id             String   @id @default(uuid())
  organizationId String
  // E.164 digits of the recipient.
  to             String
  body           String
  scheduledAt    DateTime // next occurrence for recurring rows
  // PENDING | SENDING | SENT | FAILED | CANCELLED
  status         String   @default("PENDING")
  sentMessageId  String?
  error          String?
  createdBy      String?

  // Recurrence: NONE | DAILY | WEEKLY | MONTHLY | CUSTOM_DAYS.
  // CUSTOM_DAYS uses recurEvery (n days between sends). recurUntil caps the
  // series; recurCount tracks how many have gone out.
  recurrence     String    @default("NONE")
  recurEvery     Int? // for CUSTOM_DAYS
  recurUntil     DateTime?
  recurCount     Int       @default(0)
  // The intended day-of-month for MONTHLY series. Without it, a run that
  // clamps into a short month (31 -> 30 Sep) would keep deriving from the
  // clamped day and ratchet downwards, silently drifting off month-end.
  recurAnchorDay Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  @@index([status, scheduledAt])
  @@index([organizationId, scheduledAt])
}

model WhatsAppContact {
  id             String    @id @default(uuid())
  organizationId String
  waId           String // digits-only number
  profileName    String?
  appContactName String?
  lastMessageAt  DateTime?
  // Per-number AI override: APPROVED = may auto-reply, BLOCKED = never
  // auto-reply (still drafts a suggestion for manual review), null = follow
  // the org's global agent policy.
  agentAutoReply String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  @@unique([organizationId, waId])
}

model WhatsAppAppointment {
  id             String  @id @default(uuid())
  organizationId String
  groupId        String // group the appointment was posted in, and where the reminder goes
  groupName      String?

  startsAt  DateTime // resolved appointment date/time
  timeText  String? // as written, e.g. "3pm (Tentatively)"
  topic     String?
  venue     String?
  tentative Boolean  @default(false)

  clientName String? // who the reminder greets

  // 3 days before at 09:00 local, or the next morning when it is sooner.
  remindAt       DateTime
  reminderStatus String    @default("PENDING") // PENDING | SENT | CANCELLED | FAILED
  remindedAt     DateTime?
  error          String?

  sourceMessage String? // original text, so a mis-parse can be audited
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([organizationId, groupId])
  @@index([reminderStatus, remindAt])
}

model AdAccountConnection {
  id             String    @id @default(uuid())
  organizationId String    @unique
  adAccountId    String // "act_…"
  accessToken    String // system-user token, never echoed to the portal
  accountName    String?
  currency       String?
  status         String    @default("CONNECTED") // CONNECTED | ERROR | DISCONNECTED
  lastError      String?
  lastSyncAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model AdInsight {
  id             String   @id @default(uuid())
  organizationId String
  date           DateTime // the insight day (UTC midnight)
  campaignId     String?
  campaignName   String?
  adsetId        String?
  adsetName      String?
  adId           String
  adName         String?
  spend          Float    @default(0)
  impressions    Int      @default(0)
  clicks         Int      @default(0)
  linkClicks     Int      @default(0)
  metaLeads      Int      @default(0) // Meta-reported lead actions
  thruplays      Int      @default(0)
  videoAvgSec    Float? // average watch time (seconds)
  videoP25       Int      @default(0)
  videoP50       Int      @default(0)
  videoP75       Int      @default(0)
  videoP100      Int      @default(0)
  raw            Json? // full actions payload for future metrics
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, date, adId])
  @@index([organizationId, date])
  @@index([organizationId, campaignId])
}
