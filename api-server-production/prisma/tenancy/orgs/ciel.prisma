  firstContactDeadline DateTime? // Network: 24h from distribution
  replacementDeadline  DateTime? // Network: 14 days from distribution
  quotationId          String?   @db.Uuid
  projectId            String?   @db.Uuid
  emailFrom            String?
  emailSubject         String?
  receivedAt           DateTime  @default(now())
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

