# Which org's CRM the relayed conversations belong to.
AIMS_ORG_ID=09e55c23-e031-4254-8152-a373597b2cb3
AIMS_API_BASE=https://aims-ahwy.onrender.com
# Same shared secret as the group bridge (WHATSAPP_GROUP_BRIDGE_TOKEN on the API).
AIMS_GROUP_BRIDGE_TOKEN=
# Persist the linked session so a redeploy does not force a re-scan.
SESSION_DIR=/data/.wwebjs_auth
BRIDGE_LABEL=ciel-dm-bridge
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
