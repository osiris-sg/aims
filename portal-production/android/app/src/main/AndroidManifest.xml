<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- HOME launcher: lets the device boot straight into AIMS Field
                 (Sunmi kiosk use). Android NEVER auto-adopts a new HOME app —
                 adding this only makes AIMS Field an OPTION in the launcher
                 chooser; the OS prompts the user to pick (and offers "Always"
                 vs "Just once"). The LAUNCHER filter above is kept, so the app
                 also stays in the normal app drawer. On the Samsung test device
                 simply never choose AIMS Field as Home (or pick "Just once") to
                 keep the stock launcher. Escape if it takes over: Settings →
                 Apps → Default apps → Home app → pick the stock launcher; or
                 adb: `adb shell cmd package set-home-activity <stock/.Launcher>`
                 (see the pinned note in the build report). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- NFC foreground dispatch — claim exclusive priority over system
                 handlers (Samsung's stock NFC handler in particular) while the
                 app is in the foreground. Without these, scanning a tag while
                 the app is open causes the system to push the app to the
                 background and open its own tag viewer. The matching
                 nfc_tech_filter.xml lists the tag tech types we accept. -->
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.nfc.action.TAG_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/nfc_tech_filter" />

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- BtPrinter (Classic SPP receipt printing). BLUETOOTH/ADMIN cover
         API ≤30; BLUETOOTH_CONNECT is the API 31+ runtime permission the
         plugin requests on first use. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Location + background tracking for live delivery routes.
         FINE/COARSE_LOCATION are runtime-prompted; ACCESS_BACKGROUND_LOCATION
         requires a separate "Allow all the time" grant on Android 10+.
         FOREGROUND_SERVICE_LOCATION is mandatory for targetSdk 34+ to start a
         location-typed foreground service. POST_NOTIFICATIONS gates the
         "Tracking delivery in progress" notification on Android 13+. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Camera for proof-photo capture. Without this declared, Android 11+
         package visibility hides the camera app, so Capacitor's WebView
         onShowFileChooser can't resolve ACTION_IMAGE_CAPTURE and silently
         falls back to the photo picker (gallery only, no camera option).
         Declaring CAMERA grants visibility AND makes Capacitor request the
         runtime grant before capture. camera feature is NOT required so the
         app still installs on camera-less contexts. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
</manifest>
