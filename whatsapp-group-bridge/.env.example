# AIMS Group Bridge config
AIMS_API_BASE=https://aims-ahwy.onrender.com   # prod API (or http://localhost:4040 for dev)
AIMS_ORG_ID=                                    # org whose trained agent to use (e.g. Osiris Technology's id)
AIMS_GROUP_BRIDGE_TOKEN=                         # must match WHATSAPP_GROUP_BRIDGE_TOKEN on the API server
TRIGGER=@pa\b                                    # regex that summons the PA in a group
MIN_REPLY_GAP_MS=4000                            # self-throttle between group replies
STAFF_NUMBERS=                                    # optional: Denzel's own number(s), comma-separated digits — never greeted as the client
ALLOWED_GROUPS=                                    # only act in these @g.us group ids (comma-separated); empty = all groups
REPLY_DELAY_MS=300000                             # delay before template Q&A replies (ms); intro not delayed. 300000 = 5 min

# ── AIMS Operator (all OFF unless OPERATOR_ENABLED=true) ──────────────────────
LIST_GROUPS=false                                  # true: log every group as "GROUP:: <name> -> <id>" at boot (sends nothing)
OPERATOR_ENABLED=false                             # master switch; false = bridge behaves exactly as before
OPERATOR_TOKEN=                                    # a key of WA_WEB_BRIDGES on the API (binds these chats to one org)
OPERATOR_CHATS=                                    # @g.us ids handled by the Operator instead of Denzel's agent (comma-separated)
OPERATOR_DMS=false                                 # true: DMs from anyone who is not Denzel's staff go to the Operator (/link, staff requests)
OPERATOR_TRIGGER=@san\b                            # summon word, in addition to an @mention of this account
# OPERATOR_STATE_DIR=/data                         # where operator-last-seen.json lives (default: next to SESSION_DIR)
