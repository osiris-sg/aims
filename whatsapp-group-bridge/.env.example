# AIMS Group Bridge config
AIMS_API_BASE=https://aims-ahwy.onrender.com   # prod API (or http://localhost:4040 for dev)
AIMS_ORG_ID=                                    # org whose trained agent to use (e.g. Osiris Technology's id)
AIMS_GROUP_BRIDGE_TOKEN=                         # must match WHATSAPP_GROUP_BRIDGE_TOKEN on the API server
TRIGGER=@pa\b                                    # regex that summons the PA in a group
MIN_REPLY_GAP_MS=4000                            # self-throttle between group replies
STAFF_NUMBERS=                                    # optional: Denzel's own number(s), comma-separated digits — never greeted as the client
ALLOWED_GROUPS=                                    # only act in these @g.us group ids (comma-separated); empty = all groups
REPLY_DELAY_MS=300000                             # delay before template Q&A replies (ms); intro not delayed. 300000 = 5 min
